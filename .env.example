# Copiar a .env y rellenar con valores reales. NUNCA commitear .env.
# App META de Instagram (ID público; el secret se rellena en local, nunca aquí)
META_APP_ID=2300455917409640
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
# Opcional: App Secret Proof requerido por algunas cuentas.
META_APP_SECRET_PROOF=
META_API_VERSION=v26.0

# WhatsApp Cloud API — EMA Packaging Intelligence (1111727731562433), número propio de Edge.
# Modo draft-only: nunca envía. Si WA_APP_SECRET está vacío se usa META_APP_SECRET (solo pruebas).
WA_APP_ID=1111727731562433
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
# Token del número propio. Requiere además EMA_LIVE=true y el phone id en EMA_ALLOWLIST.
WA_ACCESS_TOKEN=

# App META de Threads (El App ID de Meta y el Threads App ID son distintos)
THREADS_META_APP_ID=2301505197274475
THREADS_APP_ID=1569289800881553
THREADS_APP_SECRET=

# Clave Fernet para cifrar tokens en disco. Generar con: python -m ema.security --generate-key
EMA_MASTER_KEY=your_fernet_key
# false = dry-run obligatorio; true solo tras aprobación y allowlist.
EMA_LIVE=false
# Cuentas autorizadas (ids de IG/Threads o "instagram"/"threads"), separadas por coma.
EMA_ALLOWLIST=
EMA_TOKEN_FILE=data/tokens.enc.json
EMA_AUDIT_FILE=data/audit.jsonl
EMA_IDEMPOTENCY_DB=data/events.sqlite3
EMA_DATA_DIR=
EMA_HOST=127.0.0.1
EMA_PORT=8099
EMA_HTTP_TIMEOUT=20.0
EMA_MAX_RETRIES=3

# IDs de cuenta; los tokens se guardan cifrados en EMA_TOKEN_FILE.
IG_USER_ID=
IG_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_APP_ID=
